# ==========================================
# Zepp Life (原小米运动) 自动刷步数环境变量配置文件模板
# 使用方法：复制本文件重命名为 .env，并填入你的实际配置
# ==========================================

# 1. 账号与密码（必填）
# 支持单个账号，或多个账号用 # 分隔（例如：13800000000#abc@qq.com）
USER=13800000000
PWD=your_password

# 2. 步数随机范围设置（选填，默认 18000 ~ 25000）
MIN_STEP=18000
MAX_STEP=25000

# 3. 本地加密密钥（选填）
# 建议配置 16 位字符串密钥，用于保存和加密 Token 及已绑定设备 ID，加速后续登录
AES_KEY=1234567890123456

# 4. 多账号执行配置（选填）
SLEEP_GAP=5
USE_CONCURRENT=False

# 5. 推送服务通知配置（选填）
# PushPlus 推送配置
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# 企业微信 Webhook 机器人推送配置（旧方案）
PUSH_WECHAT_WEBHOOK_KEY=

# 企业微信智能机器人推送配置（新方案，长连接主动推送）
# 参考文档：https://open.work.weixin.qq.com/help2/pc/cat?doc_id=21661
# 需先在企业微信中创建智能机器人（API 模式 -> 长连接），并让机器人在目标会话中收到过至少一条消息
# WECOM_SMART_BOT_ID: 机器人的 BotID
# WECOM_SMART_BOT_SECRET: 机器人的 Secret
# WECOM_SMART_BOT_CHAT_ID: 推送目标会话，单聊填用户 userid，群聊填群聊 chatid
# WECOM_SMART_BOT_CHAT_TYPE: 会话类型，1 单聊 / 2 群聊 / 0 兼容模式（默认，优先按群聊发送）
WECOM_SMART_BOT_ID=
WECOM_SMART_BOT_SECRET=
WECOM_SMART_BOT_CHAT_ID=
WECOM_SMART_BOT_CHAT_TYPE=0

# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. JSON 格式全量配置（选填）
# GitHub Actions 环境中使用的 CONFIG 变量范例
# CONFIG='{"USER": "13800000000", "PWD": "your_password", "MIN_STEP": "18000", "MAX_STEP": "25000"}'
